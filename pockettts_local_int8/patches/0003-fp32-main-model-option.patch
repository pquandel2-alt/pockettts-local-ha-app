+// Local patch: PTT_MAIN_PRECISION=fp32 loads only flow_lm_main in FP32 (flow_lm_main.onnx) while the other
+// models keep --precision. INT8 quantization of flow_lm_main makes the German model slur/drop words.
+static std::string main_model_suffix(const std::string& precision) {
+    if (const char* mp = std::getenv("PTT_MAIN_PRECISION"); mp && std::string(mp) == "fp32") return "";
+    return precision == "int8" ? "_int8" : "";
+}
